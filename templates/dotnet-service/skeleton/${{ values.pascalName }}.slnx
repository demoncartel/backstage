<Solution>
  <Folder Name="/Solution Items/">
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/${{ values.pascalName }}/${{ values.pascalName }}.csproj" />
    <Project Path="src/${{ values.pascalName }}.ServiceDefaults/${{ values.pascalName }}.ServiceDefaults.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/${{ values.pascalName }}.Tests/${{ values.pascalName }}.Tests.csproj" />
  </Folder>
</Solution>
