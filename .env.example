# Copy to .env (gitignored) and fill in. Never commit real values.
# Leave a variable commented out until you have a value: an empty value
# (e.g. "GITHUB_TOKEN=") is an empty string, which makes the backend fail.

# Fine-grained GitHub PAT on the demoncartel org, all read-only:
# repository Contents + Metadata, and organization Members (for the org import
# that GitHub sign-in relies on). See README.md.
# GITHUB_TOKEN=

# GitHub OAuth App for sign-in (demoncartel org settings > OAuth Apps).
# See README.md, "GitHub sign-in".
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# Which GitHub org to discover repos and import people from, and how the
# portal is named. Defaults: demoncartel / "demoncartel Backstage".
# For the Acme Bank demo, see demo/README.md.
# GITHUB_ORG=demoncartel
# APP_TITLE=Acme Bank Developer Portal
# ORG_DISPLAY_NAME=Acme Bank

# Postgres (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage
